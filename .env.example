# Supabase
VITE_SUPABASE_URL=https://xxxxx.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# Flutterwave — public key only (safe to expose in the frontend bundle).
# Get it from: Flutterwave Dashboard → Settings → API Keys.
VITE_FLUTTERWAVE_PUBLIC_KEY=FLWPUBK-xxxxxxxxxxxx-X

# --- Server-side only (never put these in a VITE_ variable) ---
# Set on the Supabase project itself, under Edge Functions → flutterwave-verify → Secrets:
#   FLUTTERWAVE_SECRET_KEY=FLWSECK-xxxxxxxxxxxx-X
#   SUPABASE_URL and SUPABASE_SERVICE_ROLE_KEY are provided automatically by Supabase to edge functions.
